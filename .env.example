# ============================================================================
# OMP Telegram Bot Environment Configuration
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
# ============================================================================

# [REQUIRED] Telegram Bot Token from @BotFather
# Example: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# [REQUIRED] Allowed Telegram user ID (decimal integer).
# Only this user's private chat is accepted; groups and other chats are rejected.
# Find your ID by messaging @userinfobot or @raw_data_bot on Telegram.
ALLOWED_USER_ID=123456789

# [OPTIONAL for host runs] Absolute path to the omp CLI executable.
# Compose overrides this with /usr/local/bin/omp inside the container.
# OMP_BIN=/home/youruser/.local/bin/omp

# [OPTIONAL for host runs] Absolute path to the intended working directory.
# Compose overrides this with /workspace inside the container.
# DEFAULT_CWD=/home/youruser/projects/my-repo

# [RECOMMENDED for host runs] Absolute root directory for /cd navigation.
# Without WORKSPACE_ROOT, host /cd is unrestricted.
# WORKSPACE_ROOT=/home/youruser/projects/my-repo

# [OPTIONAL] Fallback model selector used if the current model exits with error.
# Default: openai-codex/gpt-5.6-luna
FALLBACK_MODEL=openai-codex/gpt-5.6-luna

# ============================================================================
# GitHub Authority & Git Configuration (for /push and OMP git tasks)
# ============================================================================
# [OPTIONAL] GitHub Personal Access Token (PAT with `repo` scope or fine-grained
# token with Contents: Read & Write). Enables token-based Git push/fetch.
# GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# [OPTIONAL] Git author identity used for commits and pushes.
# GIT_USER_NAME=your_github_username
# GIT_USER_EMAIL=your_email@users.noreply.github.com

# [OPTIONAL for Docker] Absolute host SSH directory containing id_ed25519/id_rsa
# and known_hosts. Allows SSH-based Git operations (git@github.com:...).
# HOST_SSH_DIR=/home/youruser/.ssh

# [REQUIRED for Docker Compose] Absolute host paths; do not use ~ or ${HOME}.
# Mount only the repository/project the bot should access, not your whole home.
HOST_OMP_BIN=/home/youruser/.local/bin/omp
HOST_OMP_HOME=/home/youruser/.omp
HOST_OMP_CONFIG=/home/youruser/.config/oh-my-pi
HOST_WORKSPACE_DIR=/home/youruser/projects/my-repo

# [OPTIONAL] Host user UID and GID for the Docker build
# Run `id -u` and `id -g` to check. Ensures files created by omp keep your user ownership.
# HOST_UID=1000
# HOST_GID=1000
