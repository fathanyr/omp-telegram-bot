# ============================================================================
# OMP Telegram Bot Environment Configuration
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
# ============================================================================

# [REQUIRED] Telegram Bot Token from @BotFather
# Example: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# [REQUIRED] Allowed Telegram User ID (numeric).
# Only messages from this user ID will be processed.
# Find your ID by messaging @userinfobot or @raw_data_bot on Telegram.
# Example: 123456789
ALLOWED_USER_ID=your_telegram_user_id_here

# [OPTIONAL] Path to the omp CLI executable.
# Inside Docker, this defaults to /usr/local/bin/omp.
# On host bare-metal runs, defaults to ~/.local/bin/omp.
OMP_BIN=/usr/local/bin/omp

# [OPTIONAL] Default working directory inside the environment.
# Inside Docker, defaults to /workspace (mounted to your host repo root).
# On host bare-metal runs, defaults to your home directory (~).
DEFAULT_CWD=/workspace

# [OPTIONAL] Fallback model selector used if the current model exits with error.
# Default: openai-codex/gpt-5.6-luna
FALLBACK_MODEL=openai-codex/gpt-5.6-luna

# [OPTIONAL] Host path to your local omp binary (used in docker-compose.yml)
# Default: ~/.local/bin/omp
HOST_OMP_BIN=~/.local/bin/omp

# [OPTIONAL] Host directory to mount as /workspace in Docker
# Default: ~ (your entire home directory, or path to your projects root)
HOST_WORKSPACE_DIR=~
